<!-- Металлизация торца: слоя нет, путь без width, полоска меди задана land. -->
<project name="brd">
  <schematic/>
  <layout name="main">
    <signal name="GND">
      <plating land="200" inner_land="0">
        <line x1="0" y1="0" x2="10000" y2="0"/>
      </plating>
    </signal>
  </layout>
</project>
